PORT=8080
DATABASE_URL=postgres://bank_darah:bank_darah@127.0.0.1:5432/bank_darah?sslmode=disable
JWT_SECRET=replace-with-long-random-secret
# Development key only. Generate a production key with: openssl rand -hex 32
QR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_REQUIRED=true
PMI_NAME=PMI Kota Yogyakarta
PMI_LOCATION=UDD PMI Kota Yogyakarta
PMI_LATITUDE=-7.7839
PMI_LONGITUDE=110.3798
ELIGIBLE_RADIUS_KM=10
SCHEDULER_INTERVAL_HOURS=1
DEMO_MODE=false
# --- FCM Push Notification ---
# 1. Buat project di https://console.firebase.google.com/
# 2. Buka Project Settings > Service Accounts > Generate new private key
# 3. Simpan file JSON ke path yang bisa diakses backend (misal: ./firebase-service-account.json)
# 4. Isi FCM_PROJECT_ID dengan Project ID dari Firebase Console
# 5. Isi FCM_SERVICE_ACCOUNT_PATH dengan path ke file JSON di atas
# Jika kedua variabel dikosongkan, FCM akan dinonaktifkan (graceful fallback).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
